    <string name="aether_extra_cli">Extra CLI arguments (one per line, whole-engine mode)</string>
    <string name="aether_extra_cli_hint">Reaches every remaining core knob (TLS groups/ciphers, GREASE, ALPS, …). Example: --tls-groups X25519</string>
    <string name="aether_extra_env">Extra AETHER_* settings (KEY=VALUE, one per line)</string>
