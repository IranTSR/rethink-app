    <string name="aether_disabled">Aether tunnel stopped. Your previous SOCKS5 proxy was restored.</string>
    <string name="aether_start_vpn_hint">If the VPN is off, start it after enabling Aether — the tunnel proxy is picked up on VPN start.</string>

    <string name="aether_section_transport">Transport</string>
    <string name="aether_transport_hint">MASQUE (HTTP/3 or HTTP/2) looks like ordinary HTTPS. WireGuard is faster where inspection is light. Gool / Mim nest one tunnel inside another for a different exit address — they run the whole engine.</string>
    <string name="aether_transport_masque">MASQUE (recommended)</string>
    <string name="aether_transport_wg">WireGuard</string>
    <string name="aether_transport_gool">WireGuard over MASQUE (gool)</string>
    <string name="aether_transport_gool_classic">Nested WireGuard (gool-classic)</string>
    <string name="aether_transport_mim">Nested MASQUE (mim)</string>
    <string name="aether_peer">Manual endpoint (ip:port) — skips the scan</string>
    <string name="aether_peer_hint">Leave empty to scan. Example: 162.159.196.1:443</string>
    <string name="aether_outer_peer">Outer hop (ip:port)</string>
    <string name="aether_inner_peer">Inner hop (ip:port)</string>
    <string name="aether_gool_peer">WireGuard hop (ip:port, port 2408)</string>

    <string name="aether_section_scan">Endpoint scan</string>
    <string name="aether_scan_mode">Scan mode</string>
    <string name="aether_scan_turbo">Turbo — first answer wins</string>
    <string name="aether_scan_balanced">Balanced — fastest of a few (default)</string>
    <string name="aether_scan_thorough">Thorough — sweep whole ranges</string>
    <string name="aether_scan_verified">Verified — only edges proven to answer</string>
    <string name="aether_scan_ironclad">Ironclad — real tunnel + real request per candidate</string>
    <string name="aether_scan_ip">Scan IP version</string>
    <string name="aether_scan_ip_v4">IPv4</string>
    <string name="aether_scan_ip_v6">IPv6</string>
    <string name="aether_scan_ip_dual">Dual-stack</string>
