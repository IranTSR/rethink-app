    <string name="aether_scan_excluded">Excluded endpoints (ip:port, comma-separated)</string>
    <string name="aether_quick_reconnect">Quick reconnect — reuse the last good endpoint</string>
    <string name="aether_btn_scan">Scan for endpoint</string>
    <string name="aether_btn_verify">Verify endpoint</string>
    <string name="aether_btn_clean_ip">Clean-IP scan</string>
    <string name="aether_clean_ip_hint">Strictest scan (ironclad) plus a data-plane check: a gateway is only trusted once it actually carries traffic.</string>
    <string name="aether_scan_running">Scanning… this can take a while on Thorough / Ironclad.</string>
    <string name="aether_scan_found">Found endpoint: %1$s</string>
    <string name="aether_scan_failed">Scan failed: %1$s</string>
