<!--
  Strings for the Aether tunnel engine UI (native/aether, AGPL-3.0).
  Kept in its own file so the Aether feature adds no edits to strings.xml.
-->
<resources>
    <string name="aether_title">Aether tunnel</string>
    <string name="aether_subtitle">WARP over MASQUE — a Rust engine for censored networks (v2.4.0)</string>
    <string name="aether_unsupported">Aether needs Android 8 (API 26) or newer on arm64 / armv7. This device cannot run the engine.</string>
    <string name="aether_engine_unavailable">Aether engine failed to load. The native libraries were not built or are missing for this ABI.</string>
